====================== AIRCRAFT SYSTEM MONITOR ======================""")

def aircraft_temp(temperature):
    if temperature > 90:
           status = "CRITICAL! TEMPERATURE IS WAY TOO HIGH. PLEASE TAKE ACTION"
           critical.append("Temperature")
           return temperature, status

    elif temperature < 30:
            status = "WARNING!TEMPERATURE IS TOO LOW. PLEASE TAKE ACTION"
            warning.append("Temperature")
            return temperature, status
    else:
        status = "NORMAL"
        normal.append("Temperature")
        return temperature, status

def aircraft_oil_pressure(oil_pressure):
    if oil_pressure > 60:
        status = "CRITICAL! OIL PRESSURE IS TOO HIGH. PLEASE TAKE ACTION"
        critical.append("Oil pressure")
        return oil_pressure, status

    elif oil_pressure < 30:
        status = "WARNING! OIL PRESSURE IS TOO LOW. PLEASE TAKE ACTION"
        warning.append("Oil pressure")
        return oil_pressure, status
    else:
        status = "NORMAL"
        normal.append("Oil pressure")
        return oil_pressure, status

def aircraft_rpm(engine_rmp):
    if engine_rmp > 3500:
        status = "WARNING! RPM IS TOO HIGH. PLEASE TAKE ACTION"
        warning.append("RPM")
        return engine_rmp, status
    elif engine_rmp < 1000:
        status = "CRITICAL! RPM IS TOO LOW. PLEASE TAKE ACTION"
        critical.append("RPM")
        return engine_rmp, status
    else:
        status = "NORMAL"
        normal.append("RPM")
        return engine_rmp, status

def status_crit(critical):
    for item in critical:
        print(item)
def status_warn(warning):
    for item in warning:
        print(item)



